<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The cached blocklist is large and re-downloadable; settings and rules are not. -->
        <exclude domain="file" path="blocklist.idx" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="blocklist.idx" />
    </device-transfer>
</data-extraction-rules>
